# ==========================================
# LAP OF LUXURY — ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# 1. PHONEPE PAYMENT GATEWAY
# ------------------------------------------
# PHONEPE_CLIENT_ID / PHONEPE_MERCHANT_ID:
# Significance: The Merchant ID (MID) provided by PhonePe in your PhonePe Merchant Dashboard.
# Identifies LAP OF LUXURY as the authorized recipient of payments.
PHONEPE_CLIENT_ID=""
PHONEPE_MERCHANT_ID=""

# PHONEPE_CLIENT_SECRET / PHONEPE_SALT_KEY:
# Significance: The 32 or 36 character cryptographic secret API key generated in PhonePe Merchant Dashboard under Developer Settings > API Keys.
# Used on the server to compute the SHA-256 X-VERIFY checksum for tamper-proof payment requests and verification.
PHONEPE_CLIENT_SECRET=""
PHONEPE_SALT_KEY=""

# PHONEPE_CLIENT_VERSION / PHONEPE_SALT_INDEX:
# Significance: The version index of your PhonePe key (typically 1).
PHONEPE_CLIENT_VERSION="1"
PHONEPE_SALT_INDEX="1"

# PHONEPE_ENV:
# Significance: Payment environment mode. Set to 'SANDBOX' for staging/testing or 'PRODUCTION' for live customer payments.
PHONEPE_ENV="SANDBOX"

# ------------------------------------------
# 2. WEBSITE CONFIGURATION
# ------------------------------------------
# NEXT_PUBLIC_SITE_URL / VITE_SITE_URL:
# Significance: The live domain URL of your website (e.g. https://lapofluxury.in).
VITE_SITE_URL="https://lapofluxury.in"
NEXT_PUBLIC_SITE_URL="https://lapofluxury.in"
