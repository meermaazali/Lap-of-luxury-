{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Luxury fashion item record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "subCategory": { "type": "string" },
        "department": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "secondaryImage": { "type": "string" },
        "inStock": { "type": "boolean" },
        "stockCount": { "type": "number" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "tags": { "type": "array" }
      },
      "required": ["id", "name", "category", "price", "image"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Homepage showcase banner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "image": { "type": "string" },
        "ctaText": { "type": "string" },
        "ctaLink": { "type": "string" },
        "active": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id", "title", "image"]
    },
    "Category": {
      "title": "Category",
      "description": "Store collection category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "image": { "type": "string" },
        "itemCount": { "type": "number" }
      },
      "required": ["id", "name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "pincode": { "type": "string" },
        "total": { "type": "number" },
        "subtotal": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "trackingNumber", "customerName", "phone", "total"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Payment and store settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "acceptPaymentsOnline": { "type": "boolean" },
        "upiId": { "type": "string" },
        "payeeName": { "type": "string" },
        "phonepeEnabled": { "type": "boolean" },
        "phonepeMerchantId": { "type": "string" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public and admin products collection"
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "#/entities/Banner" },
      "description": "Homepage banners collection"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Store categories collection"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders collection"
    },
    "/storeSettings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Global store settings"
    }
  }
}
